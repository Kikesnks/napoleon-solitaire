# Variables de entorno necesarias para el leaderboard global.
# Copia este archivo a `.env.local` y rellena los valores reales.
# En Vercel se configuran en Project → Settings → Environment Variables.
# NUNCA subas las claves reales a Git: .env y .env.local están en .gitignore.

# URL pública del proyecto Supabase, p. ej. https://abcdefghij.supabase.co
SUPABASE_URL=

# service_role key (Supabase → Settings → API → service_role secret).
# ¡SECRETA! Sólo se usa en el backend (Vercel Functions). Salta RLS, por lo
# que la inserción al leaderboard sólo es posible vía nuestros endpoints, que
# validan la partida antes de escribir.
SUPABASE_SERVICE_ROLE_KEY=
